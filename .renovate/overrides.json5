{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Talos - 3-day cooldown before raising upgrade PRs",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["ghcr.io/siderolabs/talos", "siderolabs/talos"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Victoria Logs - 3-day cooldown before raising upgrade PRs",
      matchDatasources: ["docker"],
      matchPackageNames: ["/victoriametrics\\/helm-charts\\/victoria-logs/"],
      minimumReleaseAge: "3 days",
    },
  ],
}
