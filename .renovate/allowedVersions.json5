{
  packageRules: [
    {
      "matchDatasources": ["docker"],
      "allowedVersions": "<2",
      "matchPackageNames": [
        "influxdb"
      ]
    },
    {
      description: "Pin emqx-operator below 2.3.0 - operator 2.3.0+ requires EMQX 5.9+ which is BSL-licensed",
      matchDatasources: ["helm"],
      matchPackageNames: ["emqx-operator"],
      allowedVersions: "<2.3.0",
    },
    {
      description: "Block k8s-stack 0.90.1 - its sync-job v0.0.12 discards all defaultRules per-rule and group overrides (helm-charts#3151)",
      matchDatasources: ["docker"],
      matchPackageNames: ["/victoriametrics\\/helm-charts\\/victoria-metrics-k8s-stack/"],
      allowedVersions: "<0.90.1 || >0.90.1",
    },
    {
      description: "Block kei 0.23.x - #706 asset-only delta hydration never advances the PrimarySync checkpoint (kei#719); 0.23.1's fix does not cover permanently-missing-master assets, same stall recurs",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rhoopr\\/kei/"],
      allowedVersions: "<0.23.0 || >=0.24.0",
    },
  ],
}