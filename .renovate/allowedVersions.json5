{
  packageRules: [
    {
      description: "Block kei >=0.23.0 - asset-only delta hydration never advances the PrimarySync checkpoint (kei#719, #765); still reproduces on 0.24.0 and needs a schema-25 DB that 0.22.x cannot read",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rhoopr\\/kei/"],
      allowedVersions: "<0.23.0",
    },
    {
      description: "Block qbittorrent 5.3.0",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      allowedVersions: "<5.3.0 || >5.3.0",
    },
  ],
}