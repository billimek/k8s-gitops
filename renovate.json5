{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigestsToSemver',
    'local>billimek/k8s-gitops//.renovate/allowedVersions.json5',
    'local>billimek/k8s-gitops//.renovate/autoMerge.json5',
    'local>billimek/k8s-gitops//.renovate/customManagers.json5',
    'local>billimek/k8s-gitops//.renovate/grafanaDashboards.json5',
    'local>billimek/k8s-gitops//.renovate/overrides.json5',
    'local>billimek/k8s-gitops//.renovate/groups.json5',
    'local>billimek/k8s-gitops//.renovate/labels.json5',
    'local>billimek/k8s-gitops//.renovate/semanticCommits.json5',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(America/New_York)',
  ],
  rebaseWhen: 'conflicted',
  platformAutomerge: true,
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  statusCheckNames: {
    minimumReleaseAge: null,
  },
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
      '/(^|/)setup/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
      '/(^|/)setup/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
      '/(^|/)setup/.+\\.ya?ml$/',
    ],
  },
}
